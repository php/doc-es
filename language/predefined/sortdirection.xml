<reference xml:id="enum.sortdirection" role="enum" xmlns="http://docbook.org/ns/docbook">
 <title>La enumeración SortDirection</title>
 <titleabbrev>SortDirection</titleabbrev>

 <partintro>
  <section xml:id="enum.sortdirection.intro">
   &reftitle.intro;
   <simpara>
    La enumeración <enumname>SortDirection</enumname> se utiliza para
    especificar la dirección en la que se ordenan los valores.
   </simpara>
   <note>
    <simpara>
     A partir de PHP 8.6.0, ninguna de las funciones incluidas con PHP acepta un
     <enumname>SortDirection</enumname>. Por ejemplo,
     <function>array_multisort</function> sigue esperando
     <constant>SORT_ASC</constant> o <constant>SORT_DESC</constant>.
    </simpara>
   </note>
  </section>

  <section xml:id="enum.sortdirection.synopsis">
   &reftitle.enumsynopsis;

   <enumsynopsis>
    <enumname>SortDirection</enumname>

    <enumitem>
     <enumidentifier>Ascending</enumidentifier>
    </enumitem>

    <enumitem>
     <enumidentifier>Descending</enumidentifier>
    </enumitem>
   </enumsynopsis>
  </section>

  <section xml:id="enum.sortdirection.examples">
   &reftitle.examples;
   <example>
    <title>Ordenar nombres con <enumname>SortDirection</enumname></title>
    <programlisting role="php" annotations="non-interactive">
<![CDATA[
<?php

function sortNames(array $names, SortDirection $direction): array
{
    match ($direction) {
        SortDirection::Ascending => sort($names),
        SortDirection::Descending => rsort($names),
    };

    return $names;
}

$names = ['Charlie', 'Alice', 'Bob'];

print_r(sortNames($names, SortDirection::Descending));
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
Array
(
    [0] => Charlie
    [1] => Bob
    [2] => Alice
)
]]>
    </screen>
   </example>
  </section>

  <section xml:id="enum.sortdirection.seealso">
   &reftitle.seealso;
   <simplelist>
    <member><link linkend="array.sorting">Ordenación de arrays</link></member>
    <member><link linkend="language.enumerations">Enumeraciones</link></member>
   </simplelist>
  </section>
 </partintro>
</reference>
