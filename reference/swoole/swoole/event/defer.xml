<refentry xml:id="swoole-event.defer" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Swoole\Event::defer</refname>
  <refpurpose>Ejecuta una función al inicio de la próxima iteración del bucle de eventos</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <modifier>static</modifier> <type>void</type><methodname>Swoole\Event::defer</methodname>
   <methodparam><type>callable</type><parameter>callback_function</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Programa una función para que se ejecute al inicio de la próxima iteración del bucle de eventos.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>callback_function</parameter></term>
    <listitem>
     <simpara>
      Función de retrollamada a ejecutar (no se permiten parámetros; se debe usar <literal>use</literal> para las variables de la función anónima).
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   No devuelve ningún valor.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Ejemplo de <function>Swoole\Event::defer</function></title>
    <programlisting role="php">
     <![CDATA[
<?php
Swoole\Event::defer(function(){
    echo "Después del EventLoop\n";
});
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>
</refentry>

