<refentry xml:id="arrayiterator.getflags" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>ArrayIterator::getFlags</refname>
  <refpurpose>Recupera los flags de comportamiento</refpurpose>
 </refnamediv>

 <refsynopsisdiv>
  &warn.deprecated.function-8-6-0;
 </refsynopsisdiv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="ArrayIterator">
   <modifier role="attribute">#[\Deprecated(since: '8.6')]</modifier>
   <modifier>public</modifier> <type>int</type><methodname>ArrayIterator::getFlags</methodname>
   <void/>
  </methodsynopsis>
  <para>
   Recupera los flags de comportamiento de <classname>ArrayIterator</classname>. Ver la función
   <link linkend="arrayiterator.setflags">ArrayIterator::setFlags</link>
   para una lista de los flags disponibles.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Devuelve los flags de comportamiento de ArrayIterator.
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.6.0</entry>
      <entry>
       Este método ha quedado obsoleto.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><methodname>ArrayIterator::setFlags</methodname></member>
    <member><methodname>ArrayIterator::valid</methodname></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

