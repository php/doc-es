<refentry xml:id="cachingiterator.offsetset" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::offsetSet</refname>
  <refpurpose>Establece un elemento en la caché</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>void</type><methodname>CachingIterator::offsetSet</methodname>
   <methodparam><type>string</type><parameter>key</parameter></methodparam>
   <methodparam><type>mixed</type><parameter>value</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Almacena <parameter>value</parameter> bajo <parameter>key</parameter> en
   la caché.
   Este método se invoca cuando se asigna un valor al
   <classname>CachingIterator</classname> con la sintaxis de array, como
   <code>$iterator['key'] = $value</code>.
   El iterador interno no se modifica.
  </simpara>
  <simpara>
   El flag <constant>CachingIterator::FULL_CACHE</constant> debe estar establecido.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>key</parameter></term>
    <listitem>
     <simpara>
      La clave del elemento a establecer.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>value</parameter></term>
    <listitem>
     <simpara>
      El nuevo valor para <parameter>key</parameter>.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lanza una <exceptionname>BadMethodCallException</exceptionname> si el flag
   <constant>CachingIterator::FULL_CACHE</constant> no está establecido.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::offsetGet</methodname></member>
   <member><methodname>CachingIterator::offsetUnset</methodname></member>
   <member><methodname>CachingIterator::getCache</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
