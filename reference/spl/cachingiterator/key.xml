<refentry xml:id="cachingiterator.key" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::key</refname>
  <refpurpose>Devuelve la clave del elemento actual</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>mixed</type><methodname>CachingIterator::key</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Devuelve la clave del elemento actual.
  </simpara>
  <simpara>
   Como el <classname>CachingIterator</classname> va un elemento por delante de
   su iterador interno, esta es la clave que se almacenó la última vez que el
   iterador avanzó, no la clave actual del iterador interno.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Devuelve la clave del elemento actual, o &null; si el iterador no es
   <link linkend="cachingiterator.valid">válido</link>.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::current</methodname></member>
   <member><methodname>CachingIterator::valid</methodname></member>
   <member><methodname>Iterator::key</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

