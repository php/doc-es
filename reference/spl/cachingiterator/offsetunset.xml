<refentry xml:id="cachingiterator.offsetunset" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::offsetUnset</refname>
  <refpurpose>Elimina un elemento de la caché</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>void</type><methodname>CachingIterator::offsetUnset</methodname>
   <methodparam><type>string</type><parameter>key</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Elimina de la caché el elemento almacenado bajo <parameter>key</parameter>.
   Este método se invoca cuando se utiliza <function>unset</function> sobre el
   <classname>CachingIterator</classname> con la sintaxis de array, como
   <code>unset($iterator['key'])</code>.
   El iterador interno no se modifica.
  </simpara>
  <simpara>
   El flag <constant>CachingIterator::FULL_CACHE</constant> debe estar establecido.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>key</parameter></term>
    <listitem>
     <simpara>
      La clave del elemento a eliminar.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lanza una <exceptionname>BadMethodCallException</exceptionname> si el flag
   <constant>CachingIterator::FULL_CACHE</constant> no está establecido.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::offsetExists</methodname></member>
   <member><methodname>CachingIterator::offsetSet</methodname></member>
   <member><methodname>CachingIterator::getCache</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
