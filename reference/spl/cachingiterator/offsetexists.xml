<refentry xml:id="cachingiterator.offsetexists" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>CachingIterator::offsetExists</refname>
  <refpurpose>Comprueba si existe un elemento en la caché</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="CachingIterator">
   <modifier>public</modifier> <type>bool</type><methodname>CachingIterator::offsetExists</methodname>
   <methodparam><type>string</type><parameter>key</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Comprueba si hay un elemento almacenado bajo <parameter>key</parameter> en
   la caché.
   Este método se invoca cuando se utiliza <function>isset</function> o <function>empty</function> sobre el
   <classname>CachingIterator</classname> con sintaxis de array, como en
   <code>isset($iterator['key'])</code>.
  </simpara>
  <simpara>
   El flag <constant>CachingIterator::FULL_CACHE</constant> debe estar activado.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>key</parameter></term>
    <listitem>
     <simpara>
      La clave que se comprueba.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Devuelve &true; si hay un elemento almacenado bajo <parameter>key</parameter>
   en la caché, &false; en caso contrario.
  </simpara>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lanza una <exceptionname>BadMethodCallException</exceptionname> si el
   flag <constant>CachingIterator::FULL_CACHE</constant> no está activado.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>CachingIterator::offsetGet</methodname></member>
   <member><methodname>CachingIterator::getCache</methodname></member>
  </simplelist>
 </refsect1>

</refentry>
