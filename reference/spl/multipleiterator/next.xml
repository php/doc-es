<refentry xml:id="multipleiterator.next" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>MultipleIterator::next</refname>
  <refpurpose>Desplaza hacia adelante todas las instancias de los iteradores adjuntos</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="MultipleIterator">
   <modifier>public</modifier> <type>void</type><methodname>MultipleIterator::next</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Desplaza hacia adelante todas las instancias de los iteradores adjuntos,
   llamando a <methodname>Iterator::next</methodname> en cada uno de ellos en
   el orden en que se adjuntaron.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>MultipleIterator::rewind</methodname></member>
   <member><methodname>MultipleIterator::valid</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

