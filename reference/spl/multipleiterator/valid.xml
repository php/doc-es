<refentry xml:id="multipleiterator.valid" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>MultipleIterator::valid</refname>
  <refpurpose>Verifica la validez de los iteradores adjuntos</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="MultipleIterator">
   <modifier>public</modifier> <type>bool</type><methodname>MultipleIterator::valid</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Verifica la validez de los iteradores adjuntos. Con
   <constant>MultipleIterator::MIT_NEED_ALL</constant>, todos ellos deben ser
   válidos; con <constant>MultipleIterator::MIT_NEED_ANY</constant>, al menos
   uno de ellos debe ser válido.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Devuelve &true; si todos los iteradores adjuntos son válidos
   (<constant>MultipleIterator::MIT_NEED_ALL</constant>) o si al menos uno es
   válido (<constant>MultipleIterator::MIT_NEED_ANY</constant>), &false; en caso
   contrario. Si no hay ningún iterador adjunto, se devuelve &false;.
  </simpara>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>MultipleIterator::__construct</methodname></member>
   <member><methodname>MultipleIterator::setFlags</methodname></member>
   <member><methodname>MultipleIterator::current</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

