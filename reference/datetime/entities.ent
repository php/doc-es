<entity name="ext.datetime.duration-too-long">
 <listitem>
  <simpara>
   Si la duración resultante excede la
   <link linkend="time-duration.intro">longitud máxima de una duración</link>,
   se lanza una <exceptionname>Time\TimeException</exceptionname>.
  </simpara>
 </listitem>
</entity>

