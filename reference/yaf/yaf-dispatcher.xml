  <!-- {{{ Yaf_Dispatcher properties -->
  <section xml:id="yaf-dispatcher.props">
   &reftitle.properties;
   <variablelist>
    <varlistentry xml:id="yaf-dispatcher.props.router">
     <term><varname>_router</varname></term>
     <listitem>
      <simpara>
       La instancia de <classname>Yaf_Router</classname> que usa el
       despachador para enrutar las peticiones.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.view">
     <term><varname>_view</varname></term>
     <listitem>
      <simpara>
       La implementación de <classname>Yaf_View_Interface</classname> usada
       para renderizar las vistas, inicializada de forma perezosa en el primer
       despacho.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.request">
     <term><varname>_request</varname></term>
     <listitem>
      <simpara>
       El objeto de petición que se está despachando.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.plugins">
     <term><varname>_plugins</varname></term>
     <listitem>
      <simpara>
       La lista de plugins registrados con
       <methodname>Yaf_Dispatcher::registerPlugin</methodname>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.instance">
     <term><varname>_instance</varname></term>
     <listitem>
      <simpara>
       Referencia estática a la única instancia del despachador.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.auto-render">
     <term><varname>_auto_render</varname></term>
     <listitem>
      <simpara>
       Si el despachador renderiza automáticamente la vista después del
       despacho. Por omisión, &true;.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.return-response">
     <term><varname>_return_response</varname></term>
     <listitem>
      <simpara>
       Si <methodname>Yaf_Application::run</methodname> devuelve el objeto de
       respuesta en lugar de enviarlo directamente. Por omisión, &false;.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.instantly-flush">
     <term><varname>_instantly_flush</varname></term>
     <listitem>
      <simpara>
       Si el cuerpo de la respuesta se vuelca en cuanto se establece. Por
       omisión, &true;.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.default-module">
     <term><varname>_default_module</varname></term>
     <listitem>
      <simpara>
       El nombre del módulo por omisión, tomado de la entrada de configuración
       <link linkend="configuration.yaf.dispatcher.defaultmodule">application.dispatcher.defaultModule</link>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.default-controller">
     <term><varname>_default_controller</varname></term>
     <listitem>
      <simpara>
       El nombre del controlador por omisión, tomado de la entrada de
       configuración
       <link linkend="configuration.yaf.dispatcher.defaultcontroller">application.dispatcher.defaultController</link>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-dispatcher.props.default-action">
     <term><varname>_default_action</varname></term>
     <listitem>
      <simpara>
       El nombre de la acción por omisión, tomado de la entrada de
       configuración <link linkend="configuration.yaf.dispatcher.defaultaction">application.dispatcher.defaultAction</link>.
      </simpara>
     </listitem>
    </varlistentry>
   </variablelist>
