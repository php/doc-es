    <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('class.yaf-application')/db:refentry/db:refsect1[@role='description']/descendant::db:methodsynopsis[not(@role='procedural')])" />
   </classsynopsis>
   <!-- }}} -->

  </section>

  <!-- {{{ Yaf_Application properties -->
  <section xml:id="yaf-application.props">
   &reftitle.properties;
   <variablelist>
    <varlistentry xml:id="yaf-application.props.config">
     <term><varname>config</varname></term>
     <listitem>
      <simpara>
       El objeto de configuración de la aplicación.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.dispatcher">
     <term><varname>dispatcher</varname></term>
     <listitem>
      <simpara>
       La instancia de <classname>Yaf_Dispatcher</classname> que usa esta
       aplicación.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.app">
     <term><varname>_app</varname></term>
     <listitem>
      <simpara>
       Referencia estática a la única instancia de la aplicación en ejecución.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.modules">
     <term><varname>_modules</varname></term>
     <listitem>
      <simpara>
       La lista de nombres de módulos registrados, obtenida de
       <link linkend="configuration.yaf.modules">application.modules</link>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.running">
     <term><varname>_running</varname></term>
     <listitem>
      <simpara>
       Si la aplicación se está ejecutando actualmente.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.environ">
     <term><varname>_environ</varname></term>
     <listitem>
      <simpara>
       El nombre del entorno de la aplicación; por omisión,
       <literal>"product"</literal>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.err-no">
     <term><varname>_err_no</varname></term>
     <listitem>
      <simpara>El código del último error, una de las constantes
       <link linkend="yaf.constants">YAF_ERR_*</link>.</simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="yaf-application.props.err-msg">
     <term><varname>_err_msg</varname></term>
     <listitem>
      <simpara>El mensaje del último error.</simpara>
     </listitem>
    </varlistentry>
   </variablelist>
  </section>
  <!-- }}} -->

 </partintro>

 &reference.yaf.entities.yaf-application;

</reference>

