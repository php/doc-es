<refentry xml:id="yaf-controller-abstract.init" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Controller_Abstract::init</refname>
  <refpurpose>Inicializador del controlador</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>void</type><methodname>Yaf_Controller_Abstract::init</methodname>
   <void />
  </methodsynopsis>
  <simpara>
   <methodname>Yaf_Controller_Abstract::__construct</methodname> es final,
   lo que significa que los usuarios no puede sobrescribirlo,
   aunque pueden definir
   <methodname>Yaf_Controller_Abstract::init</methodname>, que será invocado
   después de que el objeto controlador sea instanciado.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   No se devuelve ningún valor.
   </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Ejemplo de <methodname>Yaf_Controller_Abstract::init</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
class IndexController extends Yaf_Controller_Abstract
{
    // init() se llama justo después de instanciar el controlador,
    // antes de despachar ninguna acción
    public function init() {
        $this->getView()->assign("sitename", "Yaf Tutorial");
    }

    public function indexAction() {
        // ...
    }
}
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Controller_Abstract::__construct</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

