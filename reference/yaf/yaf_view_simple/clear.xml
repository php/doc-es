<refentry xml:id="yaf-view-simple.clear" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_View_Simple::clear</refname>
  <refpurpose>Limpiar valores asignados</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>bool</type><methodname>Yaf_View_Simple::clear</methodname>
   <methodparam choice="opt"><type>string</type><parameter>name</parameter><initializer>NULL</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Elimina de la vista una variable asignada.
   Cuando se llama sin argumento, se eliminan todas las variables asignadas.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>name</parameter></term>
    <listitem>
     <simpara>
      El nombre de la variable a eliminar; si se omite o es &null;, se eliminan
      todas las variables asignadas.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>Devuelve &true;.</simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Ejemplo de <methodname>Yaf_View_Simple::clear</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
class IndexController extends Yaf_Controller_Abstract {
    public function indexAction() {
        $this->getView()->clear("foo")->clear("bar"); // limpia "foo" y "bar"
        $this->_view->clear(); // limpia todas las variables asignadas
    }
}
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_View_Simple::assign</methodname></member>
   <member><methodname>Yaf_View_Simple::get</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

