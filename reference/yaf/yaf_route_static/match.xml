<refentry xml:id="yaf-route-static.match" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Route_Static::match</refname>
  <refpurpose>El propósito de match</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>bool</type><methodname>Yaf_Route_Static::match</methodname>
   <methodparam><type>string</type><parameter>uri</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Determina si la ruta estática coincide con un URI. Como la ruta estática
   coincide con cualquier URI, este método devuelve siempre &true;.
  </simpara>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>uri</parameter></term>
    <listitem>
     <simpara>
      El URI a comprobar.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>Siempre devuelve &true;.
   </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Ejemplo de <methodname>Yaf_Route_Static::match</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
$route = new Yaf_Route_Static();

/* la ruta estática captura cualquier URI */
var_dump($route->match("/product/detail/id/10"));
var_dump($route->match("/"));
?>
]]>
   </programlisting>
   &example.outputs.similar;
   <screen>
<![CDATA[
bool(true)
bool(true)
]]>
   </screen>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Route_Static::route</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

