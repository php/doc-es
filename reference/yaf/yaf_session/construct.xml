<refentry xml:id="yaf-session.construct" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>Yaf_Session::__construct</refname>
  <refpurpose>Constructor de Yaf_Session</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <constructorsynopsis>
   <modifier>private</modifier> <methodname>Yaf_Session::__construct</methodname>
   <void />
  </constructorsynopsis>
  <simpara>
   El constructor es privado: <classname>Yaf_Session</classname> implementa el
   patrón singleton y no puede instanciarse directamente. Se usa
   <methodname>Yaf_Session::getInstance</methodname> para obtener la instancia
   de la sesión.
  </simpara>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
<simpara>No se devuelve ningún valor.
   </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Ejemplo de <methodname>Yaf_Session::__construct</methodname></title>
   <programlisting role="php">
<![CDATA[
<?php
// El constructor es privado, así que Yaf_Session no puede
// instanciarse con "new". Se accede mediante el singleton:
$session = Yaf_Session::getInstance();
$session->start();

$session->set("user_id", 42);
echo $session->get("user_id");
?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><methodname>Yaf_Session::getInstance</methodname></member>
   <member><methodname>Yaf_Session::start</methodname></member>
  </simplelist>
 </refsect1>

</refentry>

