<!--
    See `manual.xml` for XML namespaces defaults.
    Keep the lines under 79 columns, to make the process of manual
    translation easier, and to avoid wrap-around in some other contexts.
-->
<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.snmp.changelog.object-id-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Ahora lanza un <exceptionname>ValueError</exceptionname> si
   <parameter>object_id</parameter> es un <type>array</type> vacío.
   Anteriormente, se emitía un <constant>E_WARNING</constant> y se devolvía
   &false;.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.security-valueerror">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Ahora lanza un <exceptionname>ValueError</exceptionname> si
   <parameter>security_level</parameter> no es un nivel de seguridad válido, o
   si <parameter>auth_protocol</parameter> o
   <parameter>privacy_protocol</parameter> no es un protocolo soportado y
   <parameter>security_level</parameter> lo utiliza.
   Anteriormente, se emitía un <constant>E_WARNING</constant> y se devolvía
   &false;.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror">
 <row>
  <entry>8.5.0</entry>
  <entry>
   Ahora lanza un <exceptionname>ValueError</exceptionname> cuando
   <parameter>hostname</parameter> o <parameter>community</parameter>
   contiene bytes nulos, cuando la longitud del nombre de host es igual o
   mayor a 128 bytes, cuando <parameter>community</parameter> está vacío,
   cuando el puerto es negativo o mayor que 65535, o cuando los valores de
   timeout o reintentos son menores a -1 o demasiado grandes.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.session-valueerror.v3">
 <row>
  <entry>8.5.0</entry>
  <entry>
   Ahora lanza un <exceptionname>ValueError</exceptionname> cuando
   <parameter>hostname</parameter> o <parameter>security_name</parameter>
   contiene bytes nulos, cuando la longitud del nombre de host es igual o
   mayor a 128 bytes, cuando <parameter>security_name</parameter> está vacío,
   cuando el puerto es negativo o mayor que 65535, o cuando los valores de
   timeout o reintentos son menores a -1 o demasiado grandes.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.changelog.set-type-errors">
 <row>
  <entry>8.0.0</entry>
  <entry>
   Ahora lanza un <exceptionname>TypeError</exceptionname> si
   <parameter>object_id</parameter> es un <type>string</type> y
   <parameter>type</parameter> o <parameter>value</parameter> es un
   <type>array</type>, y un <exceptionname>ValueError</exceptionname> si un
   tipo no es un único carácter.
   Anteriormente, se emitía un <constant>E_WARNING</constant> y se devolvía
   &false;.
  </entry>
 </row>
</entity>

<entity name="ext.snmp.object-id-valueerror">
 <simpara>
  Lanza un <exceptionname>ValueError</exceptionname> si
  <parameter>object_id</parameter> es un <type>array</type> vacío.
 </simpara>
</entity>

<entity name="ext.snmp.security-valueerror">
 <simpara>
  Lanza un <exceptionname>ValueError</exceptionname> si
  <parameter>security_level</parameter> no es un nivel de seguridad válido, o
  si <parameter>auth_protocol</parameter> o
  <parameter>privacy_protocol</parameter> no es un protocolo soportado y
  <parameter>security_level</parameter> lo utiliza.
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror">
 <simpara>
  A partir de PHP 8.5.0, lanza un <exceptionname>ValueError</exceptionname> si
  <parameter>hostname</parameter> o <parameter>community</parameter>
  contiene bytes nulos, si <parameter>hostname</parameter> tiene 128 bytes o
  más o contiene un puerto que no está entre 0 y 65535, si
  <parameter>community</parameter> está vacío, o si
  <parameter>timeout</parameter> o <parameter>retries</parameter> es menor
  que <literal>-1</literal> o demasiado grande.
 </simpara>
</entity>

<entity name="ext.snmp.session-valueerror.v3">
 <simpara>
  A partir de PHP 8.5.0, lanza un <exceptionname>ValueError</exceptionname> si
  <parameter>hostname</parameter> o <parameter>security_name</parameter>
  contiene bytes nulos, si <parameter>hostname</parameter> tiene 128 bytes o
  más o contiene un puerto que no está entre 0 y 65535, si
  <parameter>security_name</parameter> está vacío, o si
  <parameter>timeout</parameter> o <parameter>retries</parameter> es menor
  que <literal>-1</literal> o demasiado grande.
 </simpara>
</entity>

<entity name="ext.snmp.set-type-errors">
 <simpara>
  Lanza un <exceptionname>TypeError</exceptionname> si
  <parameter>object_id</parameter> es un <type>string</type> y
  <parameter>type</parameter> o <parameter>value</parameter> es un
  <type>array</type>.
  Lanza un <exceptionname>ValueError</exceptionname> si
  <parameter>object_id</parameter> es un <type>string</type> y
  <parameter>type</parameter> no es un único carácter, o si
  <parameter>type</parameter> es un <type>array</type> y el tipo de un
  ID de objeto no es un único carácter.
 </simpara>
</entity>

</entities>
