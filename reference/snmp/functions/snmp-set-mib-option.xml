<refentry xml:id="function.snmp-set-mib-option" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>snmp_set_mib_option</refname>
  <refpurpose>Define una opción de análisis de los ficheros <acronym>MIB</acronym></refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>void</type><methodname>snmp_set_mib_option</methodname>
   <methodparam><type>Snmp\Mib</type><parameter>option</parameter></methodparam>
   <methodparam><type>bool</type><parameter>enable</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Activa o desactiva una opción que controla cómo la biblioteca
   Net-<acronym>SNMP</acronym> analiza los ficheros <acronym>MIB</acronym>.
   Estas opciones permiten leer ficheros <acronym>MIB</acronym> que no siguen
   estrictamente la sintaxis <acronym>SMI</acronym>.
  </simpara>
  <simpara>
   Las opciones se aplican a los ficheros <acronym>MIB</acronym> que se lean
   después: con <function>snmp_read_mib</function>, cuando
   <function>snmp_init_mib</function> carga de nuevo el árbol
   <acronym>MIB</acronym>, o cuando un módulo se carga automáticamente desde los
   directorios <acronym>MIB</acronym>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>option</parameter></term>
    <listitem>
     <simpara>
      La opción a definir. Véase <enumname>Snmp\Mib</enumname> para las opciones
      disponibles.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry>
    <term><parameter>enable</parameter></term>
    <listitem>
     <simpara>
      Indica si se debe activar la opción.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   &return.void;
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Lectura de un fichero <acronym>MIB</acronym> que utiliza subrayados en los nombres</title>
   <programlisting role="php" annotations="non-interactive">
<![CDATA[
<?php

snmp_set_mib_option(Snmp\Mib::AllowUnderscores, true);
snmp_read_mib('/usr/share/snmp/mibs/VENDOR-MIB.txt');

?>
]]>
   </programlisting>
  </example>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>snmp_read_mib</function></member>
   <member><function>snmp_init_mib</function></member>
  </simplelist>
 </refsect1>
</refentry>
