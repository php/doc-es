<appendix xml:id="yac.constants" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 &reftitle.constants;
 &extension.constants;
 <para>
  <variablelist>
   <varlistentry xml:id="constant.yac-version">
    <term>
     <constant>YAC_VERSION</constant>
     (<type>string</type>)
    </term>
    <listitem>
     <simpara>
      La versión de la extensión como cadena.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.yac-max-key-len">
    <term>
     <constant>YAC_MAX_KEY_LEN</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      Longitud máxima de una clave en bytes: 48. El prefijo de una instancia
      cuenta para este límite.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.yac-max-value-raw-len">
    <term>
     <constant>YAC_MAX_VALUE_RAW_LEN</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      Longitud máxima de un valor antes de la serialización, en bytes:
      67 108 863 (<literal>(1 &lt;&lt; 26) - 1</literal>). Los valores
      mayores son rechazados.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.yac-max-raw-compressed-len">
    <term>
     <constant>YAC_MAX_RAW_COMPRESSED_LEN</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      Tamaño máximo de una entrada almacenada, en bytes: 1 048 576 (1M). Los
      valores que no caben ni siquiera después de comprimirse son rechazados.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.yac-serializer-php">
    <term>
     <constant>YAC_SERIALIZER_PHP</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      Utiliza el formato serialize de PHP como serializador (el valor
      predeterminado).
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.yac-serializer-json">
    <term>
     <constant>YAC_SERIALIZER_JSON</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      Utiliza JSON como serializador. Requiere que la extensión se compile con
      <option role="configure">--enable-json</option>.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.yac-serializer-igbinary">
    <term>
     <constant>YAC_SERIALIZER_IGBINARY</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      Utiliza igbinary como serializador. Requiere que la extensión se compile
      con <option role="configure">--enable-igbinary</option>.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.yac-serializer-msgpack">
    <term>
     <constant>YAC_SERIALIZER_MSGPACK</constant>
     (<type>int</type>)
    </term>
    <listitem>
     <simpara>
      Utiliza msgpack como serializador. Requiere que la extensión se compile
      con <option role="configure">--enable-msgpack</option>.
     </simpara>
    </listitem>
   </varlistentry>
   <varlistentry xml:id="constant.yac-serializer">
    <term>
     <constant>YAC_SERIALIZER</constant>
     (<type>string</type>)
    </term>
    <listitem>
     <simpara>
       El serializador utilizado actualmente por la extensión.
     </simpara>
    </listitem>
   </varlistentry>
  </variablelist>
 </para>
</appendix>

