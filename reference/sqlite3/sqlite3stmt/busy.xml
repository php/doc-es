<refentry xml:id="sqlite3stmt.busy" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>SQLite3Stmt::busy</refname>
  <refpurpose>Indica si el comando se ha ejecutado pero aún no ha terminado</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="SQLite3Stmt">
   <modifier>public</modifier> <type>bool</type><methodname>SQLite3Stmt::busy</methodname>
   <void/>
  </methodsynopsis>
  <simpara>
   Indica si el comando está ocupado, es decir, si se ha iniciado con
   <methodname>SQLite3Stmt::execute</methodname> y quedan filas por recuperar,
   sin haber terminado ni haber sido reiniciado todavía.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <simpara>
   Devuelve &true; si el comando se ha ejecutado y quedan filas por recuperar,
   &false; en caso contrario.
  </simpara>
 </refsect1>

