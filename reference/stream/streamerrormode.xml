<reference xml:id="enum.streamerrormode" role="enum" xmlns="http://docbook.org/ns/docbook">
 <title>La enumeración StreamErrorMode</title>
 <titleabbrev>StreamErrorMode</titleabbrev>

 <partintro>
  <section xml:id="enum.streamerrormode.intro">
   &reftitle.intro;
   <simpara>
    La enumeración <enumname>StreamErrorMode</enumname> especifica cómo se notifican los errores de
    una operación de flujo. Es el valor de la opción de contexto de flujo
    <link linkend="context.stream.error-mode"><parameter>error_mode</parameter></link>.
   </simpara>
  </section>

  <section xml:id="enum.streamerrormode.synopsis">
   &reftitle.enumsynopsis;

   <enumsynopsis>
    <enumname>StreamErrorMode</enumname>

    <enumitem>
     <enumidentifier>Error</enumidentifier>
     <enumitemdescription>
      Los errores se notifican como diagnósticos, como <constant>E_WARNING</constant>.
      Es el valor por defecto.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>Exception</enumidentifier>
     <enumitemdescription>
      Se lanza una <exceptionname>StreamException</exceptionname> para los
      errores terminantes.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>Silent</enumidentifier>
     <enumitemdescription>
      Los errores no se notifican.
     </enumitemdescription>
    </enumitem>
   </enumsynopsis>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><enumname>StreamErrorStore</enumname></member>
    <member><xref linkend="context.stream"/></member>
    <member><xref linkend="stream.errors"/></member>
   </simplelist>
  </section>
 </partintro>
</reference>
