<entities xmlns       = "http://docbook.org/ns/docbook"
          xmlns:xlink = "http://www.w3.org/1999/xlink"
          translate   = "yes">

<entity name="ext.stream.context-error-handling">
 <simpara>
  Un contexto <type>resource</type> creado con
  <function>stream_context_create</function>, o &null;.
  Sus <link linkend="context.stream">opciones de gestión de errores</link>
  determinan cómo se notifican los errores de flujo de esta llamada.
 </simpara>
</entity>

</entities>
