<reference xml:id="class.streamerror" role="class" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xi="http://www.w3.org/2001/XInclude">

 <title>La clase StreamError</title>
 <titleabbrev>StreamError</titleabbrev>

 <partintro>

  <section xml:id="streamerror.intro">
   &reftitle.intro;
   <simpara>
    Un objeto <exceptionname>StreamError</exceptionname> describe un único error
    notificado por una operación de flujo. Las instancias son creadas por PHP,
    son devueltas por <function>stream_last_errors</function> and
    <methodname>StreamException::getErrors</methodname> y se pasan a la opción de
    contexto de flujo
    <link linkend="context.stream.error-handler"><parameter>error_handler</parameter></link>.
   </simpara>
  </section>

  <section xml:id="streamerror.synopsis">
   &reftitle.classsynopsis;

   <classsynopsis class="class">
    <ooclass>
     <modifier>final</modifier>
     <modifier>readonly</modifier>
     <classname>StreamError</classname>
    </ooclass>

    <classsynopsisinfo role="comment">&Properties;</classsynopsisinfo>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>StreamErrorCode</type>
     <varname linkend="streamerror.props.code">code</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>string</type>
     <varname linkend="streamerror.props.message">message</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>string</type>
     <varname linkend="streamerror.props.wrappername">wrapperName</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>int</type>
     <varname linkend="streamerror.props.severity">severity</varname>
    </fieldsynopsis>
    <fieldsynopsis>
     <modifier>public</modifier>
     <type>bool</type>
     <varname linkend="streamerror.props.terminating">terminating</varname>
    </fieldsynopsis>
   </classsynopsis>
  </section>

  <section xml:id="streamerror.props">
   &reftitle.properties;
   <variablelist>
    <varlistentry xml:id="streamerror.props.code">
     <term><varname>code</varname></term>
     <listitem>
      <simpara>
       El caso de <enumname>StreamErrorCode</enumname> que identifica el tipo de error.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.message">
     <term><varname>message</varname></term>
     <listitem>
      <simpara>
       El mensaje de error. Es el texto del diagnóstico que se emite
       con <constant>StreamErrorMode::Error</constant>, sin el prefijo del nombre
       de la función.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.wrappername">
     <term><varname>wrapperName</varname></term>
     <listitem>
      <simpara>
       El nombre de la envoltura de flujo que notificó el error,
       por ejemplo <literal>plainfile</literal> para los ficheros locales.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.severity">
     <term><varname>severity</varname></term>
     <listitem>
      <simpara>
       El nivel con el que se notifica el error en el modo
       <constant>StreamErrorMode::Error</constant>,
       como una de las constantes
       <link linkend="errorfunc.constants.errorlevels"><constant>E_<replaceable>*</replaceable></constant></link>,
       por ejemplo <constant>E_WARNING</constant> o <constant>E_NOTICE</constant>.
      </simpara>
     </listitem>
    </varlistentry>
    <varlistentry xml:id="streamerror.props.terminating">
     <term><varname>terminating</varname></term>
     <listitem>
      <simpara>
       &true; si el error puso fin a la operación y lanza una
       <exceptionname>StreamException</exceptionname> en el modo
       <constant>StreamErrorMode::Exception</constant>, &false; en caso contrario.
      </simpara>
     </listitem>
    </varlistentry>
   </variablelist>
  </section>

  <section role="seealso">
   &reftitle.seealso;
   <simplelist>
    <member><function>stream_last_errors</function></member>
    <member><methodname>StreamException::getErrors</methodname></member>
    <member><xref linkend="stream.errors"/></member>
   </simplelist>
  </section>

 </partintro>

</reference>
