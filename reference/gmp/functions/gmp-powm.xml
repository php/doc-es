<refentry xml:id="function.gmp-powm" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>gmp_powm</refname>
  <refpurpose>Eleva un número a la potencia con modulo</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>GMP</type><methodname>gmp_powm</methodname>
   <methodparam><type class="union"><type>GMP</type><type>int</type><type>string</type></type><parameter>num</parameter></methodparam>
   <methodparam><type class="union"><type>GMP</type><type>int</type><type>string</type></type><parameter>exponent</parameter></methodparam>
   <methodparam><type class="union"><type>GMP</type><type>int</type><type>string</type></type><parameter>modulus</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   Calcula la (<parameter>num</parameter> elevada a la potencia
   <parameter>exponent</parameter>) con modulo <parameter>modulus</parameter>.
  </simpara>
 </refsect1>


 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>num</parameter></term>
     <listitem>
      <para>
       La base del número.
      </para>
      &gmp.parameter;
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>exponent</parameter></term>
     <listitem>
      <para>
       La potencia positiva a elevar la <parameter>num</parameter>.
      </para>
      &gmp.parameter;
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>modulus</parameter></term>
     <listitem>
      <para>
       El modulo.
      </para>
      &gmp.parameter;
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   El nuevo (elevado) número, como un número GMP.
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lanza una <exceptionname>ValueError</exceptionname> si <parameter>exponent</parameter> es negativo.
  </simpara>
  <simpara>
   Lanza una <exceptionname>DivisionByZeroError</exceptionname> si <parameter>modulus</parameter>
   es <literal>0</literal>.
  </simpara>
  <simpara>
   Antes de PHP 8.0.0, se emitía un <constant>E_WARNING</constant> en su lugar.
  </simpara>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Ejemplo de <function>gmp_powm</function></title>
    <programlisting role="php">
<![CDATA[
<?php
$pow1 = gmp_powm("2", "31", "2147483649");
echo gmp_strval($pow1) . "\n";
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
2147483648
]]>
    </screen>
   </example>
  </para>
 </refsect1>

</refentry>
