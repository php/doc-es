<refentry xmlns="http://docbook.org/ns/docbook" xml:id="imagick.cropthumbnailimage">
 <refnamediv>
  <refname>Imagick::cropThumbnailImage</refname>
  <refpurpose>Crea una miniatura recortada</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <modifier>public</modifier> <type>bool</type><methodname>Imagick::cropThumbnailImage</methodname>
   <methodparam><type>int</type><parameter>width</parameter></methodparam>
   <methodparam><type>int</type><parameter>height</parameter></methodparam>
   <methodparam choice="opt"><type>bool</type><parameter>legacy</parameter><initializer>&false;</initializer></methodparam>
  </methodsynopsis>
  <para>
  Crea una miniatura de tamaño fijo ampliando o reduciendo de escala la imagen y recortando
  un área específica desde el centro.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>width</parameter></term>
     <listitem>
      <para>
       El ancho de la miniatura
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>height</parameter></term>
     <listitem>
      <para>
       El alto de la miniatura
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>legacy</parameter></term>
     <listitem>
      <simpara>
       El parámetro <parameter>legacy</parameter> fue añadido en PECL imagick 3.4.0.
       Consulte el registro de cambios para más información.
      </simpara>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>

 </refsect1>

